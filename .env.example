# Required: from https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: register commands to one server instantly while developing.
# Leave empty to register globally (can take up to an hour to appear).
DEV_GUILD_ID=

# Optional
DB_PATH=./data/bilal.db
AUDIO_DIR=./assets/audio
HEALTH_FILE=./data/heartbeat
LOG_LEVEL=info
