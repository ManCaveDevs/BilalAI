{
  "name": "bilalai",
  "version": "1.0.0",
  "private": true,
  "description": "Discord bot that announces the five daily prayers in voice",
  "type": "module",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy-commands": "tsx scripts/deploy-commands.ts",
    "deploy-commands:prod": "node dist/scripts/deploy-commands.js",
    "gen-audio": "bash scripts/gen-audio.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@noble/ciphers": "^2.4.0",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "luxon": "^3.7.2",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "pino-pretty": "^13.1.3",
    "prism-media": "^1.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
